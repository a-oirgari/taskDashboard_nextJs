# ============================================
# TaskFlow — Variables d'environnement
# Copier ce fichier en .env.local
# ============================================

# Base de données MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=taskflow

# JWT Secret (changer en production !)
JWT_SECRET=taskflow-super-secret-key-change-me

# Environnement
NODE_ENV=development
